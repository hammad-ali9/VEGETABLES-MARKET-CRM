# Mandi CRM — environment variables
# Copy to .env (gitignored) and fill in real values.

# Supabase (existing)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# OpenWA gateway (new — Railway / VPS public URL)
VITE_OPENWA_URL=https://openwa-xxxx.up.railway.app/api
VITE_OPENWA_KEY=ow_op_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase Edge Function secrets (set via `supabase secrets set`):
#   OPENWA_WEBHOOK_SECRET=<same secret you give OpenWA when registering the webhook>
#   SUPABASE_SERVICE_ROLE_KEY  ← auto-injected by Supabase, do not set manually
#   SUPABASE_URL               ← auto-injected by Supabase, do not set manually
